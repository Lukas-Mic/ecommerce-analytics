# Skopiuj do .env i ustaw własne, silne hasła:  cp .env.example .env
POSTGRES_DB=warehouse
POSTGRES_USER=dwh_admin
POSTGRES_PASSWORD=zmien-mnie-admin

# Użytkownik tylko do odczytu (schemat marts) dla Power BI, Looker Studio i Metabase
BI_READER_PASSWORD=zmien-mnie-bi

# Baza aplikacyjna Metabase (ustawienia, dashboardy)
METABASE_DB_PASSWORD=zmien-mnie-metabase
# Zalecane: przypnij konkretną wersję, np. v0.5x.y
METABASE_VERSION=latest

# 127.0.0.1 = Postgres widoczny tylko lokalnie (zalecane, łączysz się tunelem SSH)
POSTGRES_BIND=127.0.0.1

# Domena dla publicznego Metabase przez Caddy (profil "public")
DOMAIN=bi.twojadomena.pl
